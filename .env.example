# SendHub - Docker Compose environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENABLE_SSL=true
SMTP_FROM=sendhub@example.com
SMTP_TO=recipient@example.com

# Host path to the folder SendHub should monitor.
# Use an absolute path or a path relative to docker-compose.yml.
# Default: ./data/scan (created automatically if it does not exist)
SCAN_FOLDER_HOST_PATH=./data/scan
